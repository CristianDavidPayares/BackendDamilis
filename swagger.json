              "application/json": {
                "schema": { "$ref": "#/components/schemas/Administrador" }
              }
            }
          },
          "400": { "description": "Error de validación" }
        }
      },
      "put": {
        "tags": ["Administradores"],
        "summary": "Actualizar un administrador (se requiere id en el body)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "type": "integer", "example": 1 },
                  "adm_usuario": { "type": "string", "example": "admin02" },
                  "adm_contrasena": { "type": "string", "example": "newpassword" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Administrador actualizado" },
          "404": { "description": "Administrador no encontrado" }
        }
      }
    },
    "/admins/{id}": {
      "delete": {
        "tags": ["Administradores"],
        "summary": "Eliminar un administrador por ID",
        "parameters": [
          {
            "name": "id",
