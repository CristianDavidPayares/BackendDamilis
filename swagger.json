                "properties": {
                  "id": { "type": "integer", "example": 1 },
                  "cli_nombre": { "type": "string", "example": "María" },
                  "cli_apellido": { "type": "string", "example": "López" },
                  "cli_email": { "type": "string", "example": "maria@ejemplo.com" },
