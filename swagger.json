              "schema": {
                "type": "object",
                "required": ["user_id", "correo"],
                "properties": {
                  "user_id": { "type": "integer", "example": 2 },
                  "correo": { "type": "string", "example": "juan@ejemplo.com" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Correo creado",
